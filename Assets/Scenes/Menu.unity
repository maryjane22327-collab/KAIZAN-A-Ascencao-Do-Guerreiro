  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Kaizan \u2014 A Ascens\xE3o do Guerreiro \xE9 um jogo de estrat\xE9gia
    em que o jogador assume o papel de um guerreiro cuja miss\xE3o \xE9 proteger
    a torre contra ondas de inimigos. Utilizando estrat\xE9gia e habilidade, o jogador
    deve defender a torre e impedir que ela seja destru\xEDda. O objetivo \xE9 resistir
    aos ataques, superar os desafios e proteger a torre at\xE9 alcan\xE7ar a vit\xF3ria.\n\nEste
    jogo foi desenvolvido pela aluna Mary Jane, com o apoio do orientador Rodolfo
    Morais e de toda equipe do CIEP e, em especial, dos patrocinadores do curso de
    Jogos Digitais: Profi-san, Nissan, Firjan SENAI, RioSolidario e SEEDUC."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7c48ebff9f17b7241be1b602a860aa0e, type: 2}
